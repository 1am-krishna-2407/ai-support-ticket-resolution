# Copy to .env and fill in real values. Never commit .env.

# --- Environment ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database (used by docker compose to build DATABASE_URL) -------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=support
# Host port for Postgres (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=55432
# Only needed when running the backend or tests outside Docker:
# DATABASE_URL=postgresql+asyncpg://support:<password>@127.0.0.1:55432/support
# TEST_DATABASE_URL=postgresql+asyncpg://support:<password>@127.0.0.1:55432/support_test

# --- Admin protection (token | local | dev) -------------------------------------
# token: admin routes require header X-Admin-Token. Generate with: openssl rand -hex 32
ADMIN_MODE=token
ADMIN_TOKEN=replace-with-output-of-openssl-rand-hex-32

# --- LLM provider (OpenAI-compatible chat completions) ---------------------------
# nvidia: nvidia/nemotron-3-super-120b-a12b via integrate.api.nvidia.com, key NEMOTRON_API_KEY (nvapi-...)
# groq:   openai/gpt-oss-120b via api.groq.com, key LLM_API_KEY (gsk_...); free tier 200k tokens/day
# LLM_BASE_URL and LLM_MODEL default per provider; set them only to override.
LLM_PROVIDER=nvidia
NEMOTRON_API_KEY=
LLM_API_KEY=
LLM_ENABLE_THINKING=true
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0

# --- Embedding provider ------------------------------------------------------------
# huggingface (default): Qwen3-Embedding-0.6B via the Hugging Face Inference Providers
#   router (served by DeepInfra), authenticated with HF_TOKEN.
# gemini: gemini-embedding-001 via the native API, authenticated with EMBEDDING_API_KEY.
EMBEDDING_PROVIDER=huggingface
# Hugging Face access token (hf_...) with permission to call Inference Providers
HF_TOKEN=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Fixed at migration time (alembic upgrade head resizes the column); max 2000 for HNSW.
EMBEDDING_DIMENSION=1024
# Only used when EMBEDDING_PROVIDER=gemini (Gemini API key from Google AI Studio)
EMBEDDING_API_KEY=
# Optional: override the provider's default endpoint
# EMBEDDING_BASE_URL=

# --- Retrieval --------------------------------------------------------------------
# Cosine-similarity threshold for evidence; tuned for Qwen3-Embedding-0.6B (docs/retrieval.md).
# Re-tune (python -m app.scripts.golden_retrieval) after changing the embedding model.
RETRIEVAL_RELEVANCE_THRESHOLD=0.45

# --- Knowledge source -----------------------------------------------------------
ALLOWED_SOURCE_DOMAINS=docs.gitlab.com

# --- Privacy / observability ----------------------------------------------------
LOG_LLM_PAYLOADS=false
# request_logs keeps metadata only; ticket text is never stored.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_RETENTION_DAYS=30

# --- Users and sessions ---------------------------------------------------------------
# Create the first admin with: python -m app.scripts.create_user --role admin ...
SESSION_TTL_HOURS=12
# Secure cookies need HTTPS; defaults to true when ENVIRONMENT=production.
# SESSION_COOKIE_SECURE=true
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Delete saved ticket analyses older than this many days (unset keeps them).
# TICKET_HISTORY_RETENTION_DAYS=365
